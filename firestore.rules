// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isGestora() {
      return request.auth != null && getUser().role == 'gestora';
    }
    function isPastor() {
      return request.auth != null && getUser().role == 'pastor';
    }
    function isAluno() {
      return request.auth != null && getUser().role == 'aluno';
    }
    function isProfissional() {
      return request.auth != null && getUser().role == 'profissional';
    }
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isGestora();
      allow update: if isGestora() || request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Pacientes ──────────────────────────────────────────
    match /pacientes/{pacienteId} {
      allow read: if isAuthenticated();
      allow create: if isGestora() || isPastor() || isProfissional();
      allow update: if isGestora() || isAluno();
      allow delete: if isGestora();
    }

    // ── Interconsultas ─────────────────────────────────────
    match /interconsultas/{id} {
      allow read: if isAuthenticated();
      allow create: if isAluno();
      allow update: if isGestora() ||
                       (isAluno() && resource.data.alunoId == request.auth.uid && resource.data.status == 'pendente');
      allow delete: if isGestora();
    }

    // ── Relatórios ─────────────────────────────────────────
    match /relatorios/{id} {
      allow read: if isGestora() ||
                     (isAluno() && resource.data.alunoId == request.auth.uid) ||
                     (isProfissional() && resource.data.status == 'aprovado') ||
                     (isPastor() && resource.data.status == 'aprovado');
      allow create: if isAluno();
      allow update: if isGestora() ||
                       (isAluno() && resource.data.alunoId == request.auth.uid && resource.data.status != 'aprovado');
      allow delete: if isGestora();
    }

    // ── Projeto / Página Inicial ───────────────────────────
    // Leitura pública (Landing Page); escrita só Gestora/Pastor
    match /projeto/{docId} {
      allow read: if true;
      allow write: if isGestora() || isPastor();
    }

    // ── Participantes (Responsáveis Técnicos, Equipe) ──────
    // Leitura pública (Landing Page); escrita só Gestora
    match /participantes/{id} {
      allow read: if true;
      allow create: if isGestora();
      allow update: if isGestora();
      allow delete: if isGestora();
    }

    // ── Avaliações ─────────────────────────────────────────
    // Aprovadas: leitura pública (Landing Page)
    // Todas: leitura autenticada; aprovação só Gestora
    match /avaliacoes/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isGestora();
      allow delete: if isGestora();
    }

    // ── Solicitações de Cadastro ───────────────────────────
    match /solicitacoes/{id} {
      allow create: if true; // cadastro público
      allow read: if isGestora() || isPastor();
      allow update: if isGestora();
      allow delete: if isGestora();
    }

    // ── Prontuários ────────────────────────────────────────
    match /prontuarios/{id} {
      allow read: if isAuthenticated();
      allow create: if isAluno() || isProfissional();
      allow update: if isGestora() || isAluno() || isProfissional();
      allow delete: if isGestora();
    }
  }
}
